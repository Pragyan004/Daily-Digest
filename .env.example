# Google Gemini API Key (for AI summarization)
GEMINI_API_KEY=your_gemini_api_key_here

# Currents API Key (for Technology/Business/World news)
CURRENTS_API_KEY=your_currents_api_key_here

# ntfy.sh Topic (for push notifications)
NTFY_TOPIC=your_unique_topic_name

# Optional: URL of your deployed PWA to open when clicking the push notification
# APP_URL=https://your-domain.com

# Optional: Custom path for digest.json (defaults to frontend/public/digest.json)
# DIGEST_OUTPUT_PATH=./frontend/public/digest.json

# Optional: Set to any value to enable debug logging
# DEBUG=1
